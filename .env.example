# ═══════════════════════════════════════════════════════════════════════════════
# BORSA ASİSTANI - ORTAM DEĞİŞKENLERİ ŞABLONu
# ═══════════════════════════════════════════════════════════════════════════════
# 
# ⚠️ GÖK CLOUD SUNUCUDA OLUŞTURULACAK
# Bu dosyayı GitHub'a PUSHLAYABILIRSINIZ (gerçek değerler yoktur)
# Sunucuda sadece .env dosyası oluşturulur ve gerçek değerler buraya yazılır
# 
# ═══════════════════════════════════════════════════════════════════════════════

# 📱 API SUNUCUSU AYARLARI
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# 📲 FLUTTER UYGULAMASI AYARLARI
# Flutter uygulaması bu adresten API'yi bulur
FLUTTER_API_ADDRESS=SUNUCU_IP_ADRESI:8000
# Örnek: FLUTTER_API_ADDRESS=34.123.45.67:8000

# 💾 VERİTABANI AYARLARI
# SQLite kullanıyoruz (yerel dosya), fakat köklü uygulamalar için bu PostgreSQL olabilir
DATABASE_PATH=./borsa_terminali.db
DATABASE_URL=sqlite:///./borsa_terminali.db

# 🔐 GÜVENLİK AYARLARI
SECRET_KEY=BURAYA_UZUN_RASTGELE_BIR_ANAHTAR_YAZILACAK
# Örnek: SECRET_KEY=abcdefghijklmnopqrstuvwxyz123456789!@#$%

# 📊 MARKET DATA API AYARLARI (Eğer gelecekte kullanılacaksa)
# yfinance açık API olduğu için anahtar gerekmez, ama gelecekteki entegrasyonlar için
ALPHA_VANTAGE_API_KEY=GEREKIRSE_YAZILACAK
# FINNHUB_API_KEY=GEREKIRSE_YAZILACAK
# IEX_API_KEY=GEREKIRSE_YAZILACAK

# 🔔 BİLDİRİM AYARLARI (Email, SMS vb.)
# Gelecekteki alert sistemi için
NOTIFICATION_EMAIL=bildirim@example.com
# TWILIO_ACCOUNT_SID=SA123456789
# TWILIO_AUTH_TOKEN=TOKEN_YAZILACAK
# SMTP_SERVER=smtp.gmail.com
# SMTP_PASSWORD=UYGULAMA_SIFRESI

# 🌐 LOG AYARLARI
LOG_LEVEL=INFO
# DEBUG, INFO, WARNING, ERROR, CRITICAL

# 🔄 BACKGROUND WORKER AYARLARI
WORKER_INTERVAL_MINUTES=30
MAX_STOCKS_PER_BATCH=50

# 🎯 TEKNİK ANALİZ AYARLARI (İsteğe bağlı)
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BOLLINGER_LENGTH=20
ATR_LENGTH=14

# 🌍 ORTAM TIPI
ENVIRONMENT=production
# development, staging, production
